+// Export initialize function for Lambda handlers
+export async function initializeServices(): Promise<EventBusLocal | null> {
+  try {
+    const ENABLE_HTTP_SERVER = process.env.ENABLE_HTTP_SERVER !== 'false';
+    
+    await initializeDatabase();
+
+    const sharedEventBus = createEventBusInstance();
+
+    if (ENABLE_HTTP_SERVER) {
